<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Bản gốc của LaunchAgent. `bin/install-app` thay __ROOT__/__HOME__ rồi chép sang
  ~/Library/LaunchAgents/ — không cần chạy tay. Sửa ở đây trước, rồi cài lại, để bản
  trong repo luôn là bản thật (giống app/Info.plist).

  Đường dẫn phải TUYỆT ĐỐI: launchd không có shell, không giãn `~`, không có $HOME
  trong ProgramArguments — nên __ROOT__/__HOME__ chỉ giãn được một lần lúc cài, không
  giãn lại mỗi lần launchd gọi.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.archi-ai-labs.now-dash</string>

  <!-- Gọi qua bin/now-dash-service chứ không gọi thẳng node: đường dẫn node của nvm mang
       số phiên bản, nâng node một lần là plist trỏ vào thư mục đã biến mất. -->
  <key>ProgramArguments</key>
  <array>
    <string>__ROOT__/bin/now-dash-service</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__ROOT__</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- Lên lại sau mọi lần thoát, kể cả thoát sạch: đây là dashboard mở suốt ngày, không
       có kiểu "thoát 0 nghĩa là xong việc". ThrottleInterval chặn vòng lặp tái sinh khi
       server chết ngay lúc khởi động (cổng bận, node hỏng) — 10 giây một nhịp, và lý do
       nằm trong service.err.log. -->
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Ghim cổng ngay trong định nghĩa service, đừng để mặc định trong config quyết
         định — hai chỗ đọc từ hai nguồn là hai chỗ sẽ trôi khỏi nhau. Con số này do
         `bin/install-app` thay lúc dựng, CÙNG một biến $PORT nó nướng vào app: đặt số
         cứng ở đây thì NOW_PORT=5000 cho ra app đi tìm cổng 5000 trong khi service vẫn
         nghe 4400, và triệu chứng là "không nối được tới server" chứ không phải một lỗi
         cổng nào đọc ra được. -->
    <key>NOW_PORT</key>
    <string>__PORT__</string>
    <!-- launchd KHÔNG nạp shell profile, nên PATH mặc định chỉ có bốn thư mục hệ thống.
         Server gọi git, ps, sqlite3, security — thiếu PATH là chúng lặng lẽ trả rỗng và
         mọi repo trên trang thành "chưa phải repo git". Homebrew đứng trước để dùng đúng
         bản git mà người dùng vẫn gõ ở terminal. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- Log để trong thư mục dữ liệu của chính dashboard — chỗ DUY NHẤT nó được phép ghi. -->
  <key>StandardOutPath</key>
  <string>__HOME__/.now-dashboard/service.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.now-dashboard/service.err.log</string>
</dict>
</plist>
