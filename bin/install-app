#!/usr/bin/env bash
# Dựng app trên Dock từ nguồn trong app/ và cài vào ~/Applications.
#
# Chạy lại được bao nhiêu lần cũng được: bundle dựng ở thư mục tạm rồi mới thay chỗ cũ,
# nên một lần dựng hỏng không để lại cái app nửa vời trên Dock.
#
#   ./bin/install-app                      # → ~/Applications/NOW Dashboard.app
#   APP_NAME="NOW ⌘" ./bin/install-app     # đổi nhãn dưới icon
#   NOW_WEBAPP=~/Applications/NOW.app ./bin/install-app
#
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP_NAME="${APP_NAME:-NOW Dashboard}"
DEST_DIR="${APP_DEST:-$HOME/Applications}"
DEST="$DEST_DIR/$APP_NAME.app"
WEBAPP="${NOW_WEBAPP:-$HOME/Applications/NOW.app}"
PORT="${NOW_PORT:-4400}"
ID="io.github.archi-ai-labs.now-dash.launcher"
LAUNCH_AGENTS_DIR="$HOME/Library/LaunchAgents"

# Chốt chặn khỏi tự bắn vào chân: DEST trùng tên với một app KHÁC (rất dễ xảy ra — web
# app Safari cũng nằm ở ~/Applications và cũng tên NOW) thì dừng, đừng đè. Bundle của
# Safari không tạo lại được bằng script, mất là phải vào Safari thêm lại tay.
if [[ -d "$DEST" ]]; then
  have="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$DEST/Contents/Info.plist" 2>/dev/null || true)"
  # Nhận cả id ĐỜI CŨ của chính app này (trước pass công-khai-hoá 8/2026 nó mang tên
  # riêng dev.hoanluu.*): không nhận là chính lượt nâng cấp đổi tên bị chặn bởi cái
  # chốt sinh ra để bảo vệ nó, và câu "đã có app khác" lúc ấy nói sai sự thật.
  if [[ "$have" != "$ID" && "$have" != "dev.hoanluu.now-dash.launcher" ]]; then
    echo "Đã có app khác ở $DEST (id: ${have:-không đọc được}) — không đè." >&2
    echo "Đặt tên khác: APP_NAME=\"…\" $0" >&2
    exit 1
  fi
fi

# ── Bộ biên dịch ────────────────────────────────────────────────────────────
# Hỏi TRƯỚC khi dựng, vì `swiftc` và `xcrun` ở /usr/bin chỉ là vỏ: chúng chuyển tiếp
# sang thư mục mà `xcode-select` đang trỏ tới, và khi thư mục ấy không có thật thì thứ
# duy nhất ra màn hình là
#
#   xcrun: error: invalid active developer path (/Library/Developer/CommandLineTools)
#
# — không một chữ nào nói phải làm gì. Ca đã xảy ra: Command Line Tools bị gỡ (hoặc
# chưa từng cài) trong khi `xcode-select` vẫn trỏ vào đó, còn Xcode.app thì nằm sẵn
# trong /Applications. Có đường đi được thì đi, và nói rõ cách chốt lại cho lần sau;
# không có thì dừng ở đây, kèm lệnh chữa.
toolchain_ok() { xcrun --find swiftc >/dev/null 2>&1; }

if ! toolchain_ok; then
  broken="$(xcode-select -p 2>/dev/null || true)"
  for cand in /Applications/Xcode.app/Contents/Developer /Library/Developer/CommandLineTools; do
    [[ -x "$cand/usr/bin/xcrun" ]] || continue
    export DEVELOPER_DIR="$cand"
    toolchain_ok && break
    unset DEVELOPER_DIR
  done
  if [[ -n "${DEVELOPER_DIR:-}" ]]; then
    echo "xcode-select đang trỏ vào ${broken:-(không đọc được)} — chỗ đó không dùng được." >&2
    echo "Lần dựng này mượn tạm $DEVELOPER_DIR. Chốt lại cho lần sau:" >&2
    echo "  sudo xcode-select --switch $DEVELOPER_DIR" >&2
  else
    echo "Không có bộ biên dịch Swift nào chạy được (xcode-select trỏ vào ${broken:-(không đọc được)})." >&2
    echo "Cài Command Line Tools:  xcode-select --install" >&2
    echo "Đã có Xcode.app rồi thì:  sudo xcode-select --switch /Applications/Xcode.app/Contents/Developer" >&2
    echo "Chỉ cần server nền, không cần icon thanh menu → xem README.md §Bắt đầu, cách cài LaunchAgent bằng tay." >&2
    exit 1
  fi
fi

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
BUNDLE="$TMP/$APP_NAME.app"
mkdir -p "$BUNDLE/Contents/MacOS" "$BUNDLE/Contents/Resources"

# ── Info.plist ──────────────────────────────────────────────────────────────
sed "s|__APP_NAME__|$APP_NAME|g" "$ROOT/app/Info.plist" >"$BUNDLE/Contents/Info.plist"

# ── Thân app ────────────────────────────────────────────────────────────────
# Đường dẫn ghim TUYỆT ĐỐI vào lúc dựng, đúng như launchd/io.github.archi-ai-labs.now-dash.plist:
# repo dời chỗ thì dựng lại, chứ không có $HOME nào để mà giãn khi LaunchServices gọi.
#
# Tên `main.swift` là bắt buộc, không phải sở thích: Swift chỉ cho viết mã ở mức ngoài
# cùng (mấy dòng `app.run()` cuối file) trong đúng một file mang tên ấy.
sed -e "s|__ROOT__|$ROOT|g" -e "s|__WEBAPP__|$WEBAPP|g" -e "s|__PORT__|$PORT|g" \
  "$ROOT/app/NowMenuBar.swift" >"$TMP/main.swift"

# Năm mã màu bóc từ styles.css. Trượt một cái là dừng ở đây, không dựng tiếp.
python3 "$ROOT/app/make-tones.py" "$ROOT/public/styles.css" >"$TMP/Tones.swift"

echo "Đang biên dịch…"
swiftc -O -whole-module-optimization \
  -target "$(uname -m)-apple-macosx13.0" \
  -o "$BUNDLE/Contents/MacOS/now-dash-menu" \
  "$TMP/main.swift" "$TMP/Tones.swift"

# ── Icon ────────────────────────────────────────────────────────────────────
# Cùng một nguồn với icon của web app (design/icon.svg → public/icon-1024.png), để hai
# icon trên Dock không phải hai đời khác nhau. Thiếu icon thì app vẫn chạy, chỉ mang
# icon trắng mặc định — nên chỉ cảnh báo, không chết.
if [[ -f "$ROOT/public/icon-1024.png" ]]; then
  ICONSET="$TMP/icon.iconset"
  mkdir -p "$ICONSET"
  for s in 16 32 128 256 512; do
    sips -z "$s" "$s" "$ROOT/public/icon-1024.png" --out "$ICONSET/icon_${s}x${s}.png" >/dev/null
    sips -z "$((s * 2))" "$((s * 2))" "$ROOT/public/icon-1024.png" \
      --out "$ICONSET/icon_${s}x${s}@2x.png" >/dev/null
  done
  iconutil -c icns "$ICONSET" -o "$BUNDLE/Contents/Resources/icon.icns"
else
  echo "Không thấy public/icon-1024.png — app sẽ mang icon mặc định." >&2
fi

# ── Thay chỗ cũ ─────────────────────────────────────────────────────────────
# "Mở lúc đăng nhập" bật hay tắt = một file plist có mặt hay không (xem
# launchd/io.github.archi-ai-labs.now-dash.menu.plist). Đọc được từ đây bằng một phép thử -f, nên
# cài lại giữ nguyên lựa chọn cũ mà không phải hỏi ai. NOW_LOGIN_ITEM=1 ép bật (lần cài
# đầu, khi chưa có gì để giữ), =0 ép tắt.
MENU_BIN="$DEST/Contents/MacOS/now-dash-menu"
LOGIN_PLIST="$LAUNCH_AGENTS_DIR/io.github.archi-ai-labs.now-dash.menu.plist"
WANT_LOGIN="${NOW_LOGIN_ITEM:-}"
[[ -z "$WANT_LOGIN" && -f "$LOGIN_PLIST" ]] && WANT_LOGIN=1
# Lựa chọn của bản label ĐỜI CŨ cũng phải sống qua lượt đổi tên — file cũ sắp bị dọn ở
# khối ngay dưới, nên phải đọc nó TRƯỚC khi dọn, không thì nâng cấp xong icon lặng lẽ
# thôi tự lên lúc đăng nhập và chẳng ai nối được hai chuyện ấy với nhau.
[[ -z "$WANT_LOGIN" && -f "$LAUNCH_AGENTS_DIR/dev.hoanluu.now-dash.menu.plist" ]] && WANT_LOGIN=1

# ── Dọn label đời cũ ────────────────────────────────────────────────────────
# Trước pass công-khai-hoá (8/2026), hai LaunchAgent mang tên riêng dev.hoanluu.*.
# Đổi tên mà không tháo bản cũ thì không phải "thừa một dòng trong Login Items": plist
# cũ vẫn RunAtLoad + KeepAlive, lần đăng nhập sau nó dựng server CŨ chiếm cổng trước,
# còn bản mới chết-dậy mỗi 10 giây với EADDRINUSE — đúng ca hai-tiến-trình-một-cổng mà
# skill /now-dash sinh ra để chặn. Tháo cả job đang chạy lẫn file, menu trước service
# (menu không KeepAlive nên tháo êm); chạy lại lần nữa thì vòng này không còn gì để dọn.
for old in dev.hoanluu.now-dash.menu dev.hoanluu.now-dash; do
  launchctl bootout "gui/$(id -u)/$old" 2>/dev/null || true
  rm -f "$LAUNCH_AGENTS_DIR/$old.plist"
done

# App đang chạy giữ nguyên binary CŨ trong bộ nhớ cho tới khi bị thoát — không có dòng
# này thì dựng lại xong vẫn là bản cũ đang ngồi trên thanh menu, và sửa gì cũng "không
# thấy đổi gì cả".
pkill -f "$MENU_BIN" 2>/dev/null || true

mkdir -p "$DEST_DIR"
rm -rf "$DEST"
mv "$BUNDLE" "$DEST"

# Không có bước này thì Finder và Spotlight có thể còn giữ icon/tên của lần dựng trước
# hàng giờ liền, và người dùng tưởng script không chạy.
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister \
  -f "$DEST" 2>/dev/null || true

# ── LaunchAgent (server nền, tự sống lại) ───────────────────────────────────
# Cùng khuôn __PLACEHOLDER__ như Info.plist ở trên. bin/now-dash tự `bootstrap` file
# này khi thấy nó có mặt ở đây — nên chỉ cần đặt đúng chỗ, không cần gọi launchctl ở
# đây. bootout bản cũ (nếu có) để lần start kế tiếp nạp lại đúng đường dẫn mới, phòng
# khi repo vừa dời chỗ và install-app chạy lại.
SERVICE_LABEL="io.github.archi-ai-labs.now-dash"
PLIST_DEST="$LAUNCH_AGENTS_DIR/$SERVICE_LABEL.plist"
mkdir -p "$LAUNCH_AGENTS_DIR"
sed -e "s|__ROOT__|$ROOT|g" -e "s|__HOME__|$HOME|g" -e "s|__PORT__|$PORT|g" \
  "$ROOT/launchd/$SERVICE_LABEL.plist" >"$PLIST_DEST"
launchctl bootout "gui/$(id -u)/$SERVICE_LABEL" 2>/dev/null || true
# `bootout` trả về TRƯỚC khi launchd tháo xong job, và `bootstrap` gọi vào giữa lúc job
# còn đang tháo thì trượt — im lặng, mã lỗi nuốt mất, plist nằm đó mà launchd không nạp.
# Đo được ở lần chạy đầu bản này: install-app báo "service chưa lên", rồi service vẫn tự
# lên vài giây sau — vì app menu-bar khởi động sau đó gọi lại bin/now-dash và lần ấy thì
# job đã tháo xong. Chờ ở đây thì không phải trông vào cú cứu tình cờ đó nữa.
for _ in $(seq 1 40); do
  launchctl print "gui/$(id -u)/$SERVICE_LABEL" >/dev/null 2>&1 || break
  sleep 0.25
done
echo "Đã cài LaunchAgent: $PLIST_DEST"

# `bootout` ở trên mới chỉ THÁO cái cũ ra. Nạp lại ngay tại đây, đừng để dành: bản trước
# dừng ngay sau bootout và tin rằng "lần start kế tiếp" sẽ nạp — nhưng người vừa chạy
# install-app thì tin là đã cài xong, nên chẳng có lần start nào cả. Kết quả là plist
# nằm đúng chỗ mà launchd chưa từng biết tới nó: không tiến trình, không log, không lỗi.
# Gọi qua bin/now-dash để phần dựng server vẫn chỉ có MỘT bản (bootstrap → kickstart →
# chờ ping), không phải bản thứ hai chép ở đây.
echo "Đang dựng service…"
NOW_PORT="$PORT" "$ROOT/bin/now-dash" --no-open \
  || echo "Service chưa lên — log: ~/.now-dashboard/service.err.log" >&2

# ── Mở app ──────────────────────────────────────────────────────────────────
# Đặt/gỡ mục đăng nhập bằng CHÍNH app vừa dựng (`NOW_LOGIN=on|off` ghi hoặc xoá plist),
# không phải bằng một khúc sed thứ hai ở đây: cùng một việc mà có hai bản là hai bản sẽ
# trôi khỏi nhau, và bản ít người chạy sẽ là bản hỏng.
case "$WANT_LOGIN" in
  1) NOW_LOGIN=on "$MENU_BIN" >/dev/null && echo "Icon lúc đăng nhập: bật" ;;
  0) NOW_LOGIN=off "$MENU_BIN" >/dev/null && echo "Icon lúc đăng nhập: tắt" ;;
esac

# Hai plist đều chỉ được đọc lúc đăng nhập lần sau hoặc lúc launchd nạp, tức là một lỗi
# cú pháp ở đây không kêu lên ngay bây giờ mà kêu vào lúc không còn ai ngồi xem.
for p in "$PLIST_DEST" "$LOGIN_PLIST"; do
  [[ -f "$p" ]] || continue
  plutil -lint "$p" >/dev/null || echo "plist hỏng: $p" >&2
done

# macOS cho phép tắt một agent SAU LƯNG launchd (System Settings → General → Login Items
# → Allow in the Background). Khi đó plist vẫn nằm đúng chỗ, script này vẫn báo "bật", và
# đăng nhập vào thì không có gì lên — không log, không lỗi, không ai nói gì. Chỉ có
# `print-disabled` biết, nên hỏi nó ngay lúc còn có người ngồi đây đọc.
disabled="$(launchctl print-disabled "gui/$(id -u)" 2>/dev/null || true)"
for label in "$SERVICE_LABEL" io.github.archi-ai-labs.now-dash.menu; do
  grep -q "\"$label\" => disabled" <<<"$disabled" || continue
  echo "⚠ macOS đang TẮT $label — nó sẽ không tự lên khi đăng nhập." >&2
  echo "  Bật lại: System Settings → General → Login Items → Allow in the Background," >&2
  echo "  hoặc:    launchctl enable gui/$(id -u)/$label" >&2
done

# Lý do dòng này có mặt: một app thanh menu vừa cài mà chưa chạy thì trên màn hình
# KHÔNG có gì khác trước lúc cài — không icon, không cửa sổ, không thông báo. Người dùng
# chỉ thấy script in "đã cài" rồi im, và kết luận hợp lý duy nhất là nó hỏng.
open "$DEST" 2>/dev/null || echo "Chưa mở được app — mở tay: open \"$DEST\"" >&2

echo "Đã cài: $DEST"
[[ "$WANT_LOGIN" == "1" ]] || echo "Muốn icon tự lên sau khi đăng nhập: ./bin/now-menu on (hoặc chuột phải lên icon → Hiện trên thanh menu)"
[[ -d "$WEBAPP" ]] || echo "Chưa thấy web app ở $WEBAPP — app sẽ mở bằng trình duyệt mặc định. Xem README.md §Chạy như app riêng trên Dock." >&2
